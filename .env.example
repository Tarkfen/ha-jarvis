# URL of your Home Assistant instance
# Example: http://homeassistant.local:8123 or http://192.168.1.x:8123
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token from Home Assistant
# How to get it: Profile (bottom left) → Long-Lived Access Tokens → Create Token
HA_TOKEN=your_long_lived_access_token_here

# Anthropic API key (starts with sk-ant-)
# Get it at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Server settings (you can leave these as-is)
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
